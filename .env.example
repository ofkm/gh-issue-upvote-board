# .env.example
# Copy this file to .env and customize the values

# GitHub repository to track
GITHUB_OWNER=getarcaneapp
GITHUB_REPO=arcane

# Filter by label (leave empty for no filter)
GITHUB_LABEL=needs more upvotes

# Issue state: open, closed, or all
GITHUB_STATE=open

# GitHub Personal Access Token (optional, but recommended)
# Get yours at: https://github.com/settings/tokens
# Or use: gh auth token
GITHUB_TOKEN=

# Server port
PORT=8080
